# Copy to .env next to docker-compose.yml and fill in.

# Required. Google AI Studio key for embeddings, generation and the judge.
GEMINI_API_KEY=

# Required to run evaluations (POST /api/eval/run spends Gemini credits).
# Any long random string; send it as the X-API-Key header.
EVAL_API_KEY=

# Recommended on a server: the Postgres password (URL-safe characters only)
# and the public port. Set the password before the first start; see
# docs/DEPLOYMENT.md to change it on an existing database.
# POSTGRES_PASSWORD=postgrespassword
# WEB_PORT=5173

# Optional overrides (defaults shown).
# LLM_MODEL=gemini-3.5-flash-lite
# GEMINI_JUDGE_MODEL=gemma-4-31b-it
# EMBEDDING_MODEL=gemini-embedding-001
# RAG_TOP_K=5
# RAG_MAX_DISTANCE=0.8
